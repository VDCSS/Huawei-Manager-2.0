#!/usr/bin/env bash
# huawei — shell dispatcher para Huawei Manager 2.0
# Instalado em ~/.local/bin/huawei via install.sh
# Placeholders: __VENV_DIR__ (substituído pelo render_template)

set -euo pipefail

VERSION="2.0.0"
APP_BIN="__VENV_DIR__/bin/huawei-manager"

# ── Cores ──────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# ── Helpers ────────────────────────────────────────────────────
die()   { echo -e "${RED}ERRO${NC} $1" >&2; exit 1; }
info()  { echo -e "${CYAN}INFO${NC}  $1"; }
ok()    { echo -e "${GREEN}OK${NC}    $1"; }
warn()  { echo -e "${YELLOW}WARN${NC}  $1"; }
note()  { echo -e "       ·  $1"; }

# ── Distro detection ───────────────────────────────────────────
_detect_distro() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        echo "${ID:-unknown}"
    elif command -v lsb_release >/dev/null 2>&1; then
        lsb_release -is | tr '[:upper:]' '[:lower:]'
    else
        echo "unknown"
    fi
}

# ── Subcomandos ────────────────────────────────────────────────
cmd_manager() {
    if [ ! -x "$APP_BIN" ]; then
        die "Huawei Manager não está instalado.\n  Execute: ./setup/install.sh install"
    fi
    exec "$APP_BIN" "$@"
}

cmd_check() {
    echo -e "${BOLD}Huawei Manager $VERSION — Diagnóstico${NC}\n"

    local errors=0 warnings=0

    check() {
        local desc="$1" cmd="$2" sev="${3:-error}"
        if eval "$cmd" >/dev/null 2>&1; then
            ok "$desc"
            return
        fi
        case "$sev" in
            error)   echo -e "${RED}ERRO${NC}  $desc"; errors=$((errors + 1)) ;;
            warning) echo -e "${YELLOW}WARN${NC}  $desc"; warnings=$((warnings + 1)) ;;
            *)       note "$desc — ausente (informativo)" ;;
        esac
    }

    # Python
    check "python3" "command -v python3"
    check "python3 >= 3.12" 'python3 -c "import sys; sys.exit(0 if sys.version_info >= (3,12) else 1)"'

    # .venv
    local VENV_DIR
    VENV_DIR="$(dirname "$(dirname "$APP_BIN")")"
    check ".venv" "test -f $VENV_DIR/bin/python3"
    check "huawei-manager" "test -x $APP_BIN"

    # Imports
    check "import huawei_manager" "$VENV_DIR/bin/python3 -c 'from huawei_manager import main'"
    check "sqlite3" "$VENV_DIR/bin/python3 -c 'import sqlite3'" "warning"

    # Desktop
    check "desktop entry" "test -f $HOME/.local/share/applications/huawei-manager.desktop" "warning"
    check "shell dispatcher" "test -x $HOME/.local/bin/huawei" "info"
    check "tab completion" "test -f $HOME/.local/share/bash-completion/completions/huawei" "warning"

    # Distro
    local distro
    distro=$(_detect_distro)
    note "Distribuição: $distro"

    # PATH
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ok "PATH inclui ~/.local/bin" ;;
        *) warn "~/.local/bin NÃO está no PATH — adicione: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
    esac

    echo ""
    if [ "$errors" -gt 0 ]; then
        echo -e "${RED}${errors} erro(s)${NC} · ${YELLOW}${warnings} warning(s)${NC}"
        echo -e "  ${BOLD}Dica:${NC} Rode $(dirname "$(dirname "$APP_BIN")")/../setup/install.sh reset"
        return 1
    elif [ "$warnings" -gt 0 ]; then
        echo -e "${YELLOW}${warnings} warning(s)${NC}"
        return 0
    else
        echo -e "${GREEN}Tudo OK${NC}"
        return 0
    fi
}

cmd_version() {
    echo "Huawei Manager $VERSION"
}

cmd_help() {
    cat <<EOF
${BOLD}Huawei Manager${NC} $VERSION — CLI para gerenciamento de equipamentos Huawei

${BOLD}Uso:${NC}
  huawei <comando> [opções]

${BOLD}Comandos:${NC}
  manager        Abre a interface gráfica (padrão se sem argumentos)
  check          Diagnóstico do ambiente e dependências
  version        Mostra a versão
  help           Mostra esta mensagem

${BOLD}Exemplos:${NC}
  huawei manager              # Abre a interface gráfica
  huawei check                # Verifica se tudo está instalado corretamente
  huawei manager --help       # Ajuda da interface gráfica

${BOLD}Configuração:${NC}
  ~/.config/huawei-manager/.env    Variáveis de ambiente (auto-gerado no 1º boot)
  ~/.huawei_manager/inventory.db   Banco de dados local

${BOLD}Links:${NC}
  GitHub: https://github.com/VDCSS/Huawei-Manager-2.0
EOF
}

# ── Main ───────────────────────────────────────────────────────
case "${1:-}" in
    manager)  shift; cmd_manager "$@" ;;
    check)    cmd_check ;;
    version)  cmd_version ;;
    help|-h|--help) cmd_help ;;
    "")
        # Sem argumentos: abre a GUI
        cmd_manager
        ;;
    *)
        die "Comando desconhecido: $1\n  Rode 'huawei help' para ver os comandos disponíveis."
        ;;
esac
