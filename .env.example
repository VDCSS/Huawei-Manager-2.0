# ============================================================
# Huawei Manager 2.0 — .env de exemplo
#
# Destino real: ~/.config/huawei-manager/.env
#   - Auto-gerado no primeiro boot (src/huawei_manager/_config.py)
#   - Completar chaves de criptografia: python3 setup/ensure_env.py
#   - Copie este arquivo para la apenas se quiser pre-configurar:
#       mkdir -p ~/.config/huawei-manager
#       cp .env.example ~/.config/huawei-manager/.env
#
# CREDENCIAIS DE DISPOSITIVO nao ficam aqui: o cadastro de devices
# (host/port/username/password) vive no SQLite, cifrado com
# VNF_ENCRYPT_KEY.
# ============================================================

# --- Dispositivo Huawei (SSH) — config global ----------------
# host/port/username/password NAO ficam aqui: o cadastro de
# devices (SQLite, cifrado com VNF_ENCRYPT_KEY) é a única fonte
# de verdade — sem device selecionado a conexao falha fechado.
# Chave SSH: padrao quando o Device nao define ssh_key
ROUTER_SSH_KEY=~/.ssh/huawei_ed25519
# Verificacao de host key: strict | tofu | off
ROUTER_HOSTKEY_VERIFY=strict

# --- Criptografia local -------------------------------------
# Auto-gerada no primeiro boot se ausente (fail-closed: sem chave = segredos nao salvos)
VNF_ENCRYPT_KEY=
# HMAC-SHA256 das entradas do log de auditoria
AUDIT_HMAC_KEY=

# --- Comportamento ------------------------------------------
HW_ADAPTIVE_POLLING=0
# Timeout de conexao SSH (segundos)
SSH_TIMEOUT=90
# Timeout do probe de devices (segundos)
VNF_PROBE_TIMEOUT=5
# Workers dos pools de I/O e CPU
HW_IO_WORKERS=6
HW_CPU_WORKERS=2
# Modo do controlador: mock | real
HW_SVC_MODE=mock

# ============================================================
# Backends de secrets: env | crypto | sops | vault | aws
# ============================================================
SECRETS_BACKEND=env

# Backend "crypto" — chave AES-256-GCM (32 bytes), obrigatória nesse modo
SECRETS_KEY=

# Backend "sops" — arquivo secrets.enc.yaml (encryptado via CLI sops/age)
# Gerar com: make encrypt-sops
SOPS_AGE_KEY_FILE=

# Backend "vault" — HashiCorp Vault (requer extra [vault]: pip install -e ".[vault]")
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_MOUNT=secret
VAULT_SECRET_PATH=huawei/manager

# Backend "aws" — AWS Secrets Manager (requer extra [aws]: pip install -e ".[aws]")
AWS_REGION=us-east-1
AWS_SECRET_NAME=huawei/manager/creds

# ---------------------------------------------------------------
# Rotação de senha (D7) — passo MANUAL, fora do fluxo automático
# ---------------------------------------------------------------
# 1. Troque a senha no dispositivo via console ou SSH administrativa
#    (fora do Huawei Manager).
# 2. Atualize a senha no cadastro de devices (aba Devices) — ela é
#    cifrada no SQLite com VNF_ENCRYPT_KEY. Se o device usar
#    "password_env", atualize a variável referenciada neste arquivo.
# 3. Regenerar o cofre sops:  make encrypt-sops
# 4. Nunca commitar senha em texto puro — o vnf_inventory.json /
#    SQLite NUNCA devem conter senha em claro (fail-closed).
