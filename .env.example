# ============================================================
# Huawei Manager 2.0 — .env de exemplo
# Copie para .env e preencha:  cp .env.example .env
# ============================================================

# --- Dispositivo Huawei (SSH) -------------------------------
ROUTER_HOST=192.168.1.1
ROUTER_PORT=22
ROUTER_USERNAME=admin
# ROTACIONAR MANUALMENTE no equipamento e preencher (D7)
ROUTER_PASSWORD=
# Chave ED25519 gerada pelo app (rotação de chave SSH)
ROUTER_SSH_KEY=~/.ssh/huawei_ed25519
# Verificação de host key: strict | tofu | off
ROUTER_HOSTKEY_VERIFY=strict

# --- RBAC local ---------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TECNICO_USERNAME=tecnico
# ROTACIONAR MANUALMENTE no equipamento e preencher (D7)
TECNICO_PASSWORD=

# --- Criptografia local -------------------------------------
# Auto-gerada no primeiro boot se ausente (fail-closed: sem chave = segredos nao salvos)
VNF_ENCRYPT_KEY=
# HMAC-SHA256 das entradas do log de auditoria
AUDIT_HMAC_KEY=

# --- Comportamento ------------------------------------------
HW_ADAPTIVE_POLLING=0

# ============================================================
# Backends de secrets: env | crypto | sops | vault | aws
# ============================================================
SECRETS_BACKEND=env

# Backend "crypto" — chave AES-256-GCM (32 bytes), obrigatória nesse modo
SECRETS_KEY=

# Backend "vault" — HashiCorp Vault (requer extra [vault]: pip install -e ".[vault]")
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_MOUNT=secret
VAULT_SECRET_PATH=huawei/manager

# Backend "aws" — AWS Secrets Manager (requer extra [aws]: pip install -e ".[aws]")
AWS_REGION=us-east-1
AWS_SECRET_NAME=huawei/manager/creds

# ---------------------------------------------------------------
# Rotação de senha (D7) — passo MANUAL, fora do fluxo automático
# ---------------------------------------------------------------
# 1. Troque a senha no dispositivo ("Switch teste" / roteador alvo) via
#    console ou SSH administrativo (fora do Huawei Manager).
# 2. Atualize ROUTER_PASSWORD / TECNICO_PASSWORD neste arquivo com a
#    nova senha rotacionada.
# 3. Regenerar o secrets criptografado:  make encrypt-env
#    (exige SECRETS_KEY no ambiente ou em .env)
# 4. Nunca commitar senha em texto puro — o vnf_inventory.json NÃO deve
#    conter campo password (fail-closed no save desde a W1).
